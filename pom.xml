<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>org.ledgerark</groupId>
    <artifactId>ledgerark</artifactId>
    <version>0.0.1</version>

    <packaging>pom</packaging>

    <modules>
        <module>ledgerark-admin</module>
        <module>ledgerark-common</module>
        <module>ledgerark-framework</module>
        <module>ledgerark-system</module>
    </modules>

    <properties>
        <ledgerark.version>0.0.1</ledgerark.version>
        <java.version>21</java.version>
        <lombok.version>1.18.46</lombok.version>
        <mysql.version>26.7.0</mysql.version>
        <hutool.version>5.8.47</hutool.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- mysql驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>


            <!-- hutool工具包 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 核心模块 -->
            <dependency>
                <groupId>org.ledgerark</groupId>
                <artifactId>ledgerark-framework</artifactId>
                <version>0.0.1</version>
            </dependency>

            <!-- 系统模块 -->
            <dependency>
                <groupId>org.ledgerark</groupId>
                <artifactId>ledgerark-system</artifactId>
                <version>${ledgerark.version}</version>
            </dependency>


            <!-- 通用工具 -->
            <dependency>
                <groupId>org.ledgerark</groupId>
                <artifactId>ledgerark-common</artifactId>
                <version>${ledgerark.version}</version>
            </dependency>



        </dependencies>
    </dependencyManagement>

    <!-- 测试依赖：所有子模块自动继承（scope=test 不会打进产物 jar） -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- 将 lombok 作为作为注解处理器添加进去 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
